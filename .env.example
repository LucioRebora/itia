# Base de datos Postgres
DATABASE_URL=postgres://usuario:password@host:5432/db

# API de Anthropic para el chatbot
ANTHROPIC_API_KEY=
# Opcional: por defecto claude-opus-5
ANTHROPIC_MODEL=

# Envío de mails (Resend)
RESEND_KEY=
# Remitente. Debe pertenecer a un dominio verificado en Resend.
# Si se omite usa onboarding@resend.dev, que sólo entrega al dueño de la cuenta.
MAIL_FROM="ITIA <notificaciones@itia.ar>"
# Casilla que recibe los avisos. Por defecto contacto@itia.ar
MAIL_TO=contacto@itia.ar
